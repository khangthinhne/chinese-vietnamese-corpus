{
  "common": {
    "work_id": "CPO_18",
    "data_root": "data",
    "title": "Demo CPO_18 (chế độ cũ: OCR theo lớp)",
    "dpi": 300
  },
  "layers": {
    "han": {
      "pdf": "data/CPO_18/01_sources/CPO18.pdf",
      "pages": "205-210",
      "region": "0,0.08,1,0.93",
      "engines": "tesseract"
    },
    "am": {
      "pdf": "data/CPO_18/01_sources/CPO18.pdf",
      "pages": "205-210",
      "region": "0,0.08,1,0.93",
      "engines": "tesseract"
    },
    "nghia": {
      "pdf": "data/CPO_18/01_sources/CPO18.pdf",
      "pages": "205-210",
      "region": "0,0.08,1,0.93",
      "engines": "tesseract"
    }
  },
  "clean": {
    "am": {
      "drop_pattern": ["^Phần II"]
    },
    "nghia": {
      "drop_pattern": ["^Phần II"]
    }
  },
  "metadata_extraction": {
    "enabled": true,
    "layers": {
      "han": {
        "title_patterns": ["^\\s*\\d{1,3}\\s*[·.．、﹒)]"],
        "attribution_patterns": ["^.{0,3}\\*"],
        "author_max_len": 8
      },
      "am": {
        "section_start": ["^PHIÊN ÂM\\s*:?$"],
        "section_end": ["^DỊCH NGHĨA\\s*:?$"],
        "attribution_patterns": ["^\\*"]
      },
      "nghia": {
        "section_start": ["^DỊCH NGHĨA\\s*:?$"],
        "section_end": ["^CHÚ THÍCH\\s*:?$"],
        "attribution_patterns": ["^\\*"]
      }
    }
  },
  "pairs": {
    "han-am": {
      "method": "levenshtein",
      "opt": ["reading_dict=resources/han_viet.tsv"],
      "name": "CPO_18_han-am_parallel"
    },
    "han-nghia": {
      "method": "length",
      "name": "CPO_18_han-nghia_parallel"
    }
  }
}

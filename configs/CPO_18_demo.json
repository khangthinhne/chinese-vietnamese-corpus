{
  "common": {
    "work_id": "CPO_18",
    "data_root": "data",
    "title": "Demo CPO_18 (chế độ mới: OCR theo hệ chữ -> phân đoạn tài liệu/lớp)",
    "source": "data/CPO_18/01_sources/CPO18.pdf",
    "pages": "205-212",
    "dpi": 300,
    "workers": 4
  },
  "ocr": {
    "chi_tra": {
      "engines": "tesseract",
      "region": "0,0.08,1,0.93",
      "lang": "chi_tra",
      "keep": "cjk",
      "psm": 6,
      "dpi": 300,
      "workers": 4,
      "low_conf": 60
    },
    "vie": {
      "engines": "tesseract",
      "region": "0,0.08,1,0.93",
      "lang": "vie",
      "keep": "latin",
      "psm": 6,
      "dpi": 300,
      "workers": 4,
      "low_conf": 60
    }
  },
  "segmentation": {
    "enabled": true,
    "document": {
      "numbered_heading": true,
      "start_patterns": [],
      "end_patterns": [],
      "case_sensitive": false
    },
    "layers": {
      "han": {
        "source": "chi_tra",
        "title_patterns": [
          "^\\s*\\d{1,3}\\s*[·.．、﹒)]"
        ],
        "attribution_patterns": [
          "^.{0,3}\\*"
        ],
        "author_max_len": 8
      },
      "am": {
        "source": "vie",
        "heading_mode": true,
        "start_patterns": [
          "^PHIÊN\\s+ÂM\\b"
        ],
        "end_patterns": [
          "^DỊCH\\s+NGHĨA\\b"
        ],
        "attribution_patterns": [
          "^\\*"
        ]
      },
      "nghia": {
        "source": "vie",
        "heading_mode": true,
        "start_patterns": [
          "^DỊCH\\s+NGHĨA\\b"
        ],
        "end_patterns": [
          "^CHÚ\\s+THÍCH\\b"
        ],
        "attribution_patterns": [
          "^\\*"
        ]
      }
    }
  },
  "clean": {
    "am": {
      "drop_pattern": [
        "^Phần II"
      ]
    },
    "nghia": {
      "drop_pattern": [
        "^Phần II"
      ]
    }
  },
  "metadata_extraction": {
    "enabled": true,
    "exclude_from_main_text": true
  },
  "pairs": {
    "han-am": {
      "method": "levenshtein",
      "opt": [
        "reading_dict=resources/han_viet.tsv"
      ],
      "name": "CPO_18_han-am_parallel"
    },
    "han-nghia": {
      "method": "length",
      "name": "CPO_18_han-nghia_parallel"
    }
  }
}
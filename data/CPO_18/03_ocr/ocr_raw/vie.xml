        <PAGE NUMBER="211" IMAGE="E:\Projects\han-viet-corpus\data\CPO_18\02_extraction\pages\page_211.png" IMAGE_SHA256="a79096af54358fb45ba03a921d8854992469a466ca25a859e848ceffe56f12aa" RAW="03_ocr/raw/qwen/0211.json" SELECTED_ENGINE="qwen" SELECTED_KEY="dfbf97be1130e62c2910d0fdf155f6d6ff49816eb1830764462cb87e28ee36a5" CONFIDENCE="93.63" EMPTY="false" N_LINES="10" N_SRC_LINES="10" N_DROPPED="0" CJK_REMOVED="0">
            <LINE ID="P0211.L001" ORDER="1" NO="1" SRC_LINE="1" BBOX="302,0,2428,260" CONFIDENCE="94.58">Phần II: Nguyên văn tác phẩm dịch và chú thích</LINE>
            <LINE ID="P0211.L002" ORDER="2" NO="2" SRC_LINE="2" BBOX="302,260,2428,521" CONFIDENCE="94.58">Thích Đạo Cao xin thưa: Được bề trên hỏi tới dấu tích khi hiện rõ, khi ẩn khuất của đáng chí thánh (1), ý</LINE>
            <LINE ID="P0211.L003" ORDER="3" NO="3" SRC_LINE="3" BBOX="326,519,2428,723" CONFIDENCE="94.94">vị sâu rộng, lời lẽ sáng sủa, kính cẩn xem đi xem lại, thấy ngài thanh danh tiếng tốt càng cao.</LINE>
            <LINE ID="P0211.L004" ORDER="4" NO="4" SRC_LINE="4" BBOX="326,723,2428,927" CONFIDENCE="94.94">Sứ quân (2) tường vách cao kín (3), hiểu cho được giáo pháp tất nhiên khó khăn; vậy xin dốc hết chút hiểu biết</LINE>
            <LINE ID="P0211.L005" ORDER="5" NO="5" SRC_LINE="5" BBOX="333,931,2428,1226" CONFIDENCE="92.04">chật hẹp của kẻ ngu dại này, những mong giống như chuyện tượng vỡ được huyền châu (4).</LINE>
            <LINE ID="P0211.L006" ORDER="6" NO="6" SRC_LINE="6" BBOX="333,1226,2428,1521" CONFIDENCE="92.04">Xét ra, Như Lai (5) ứng vật gồm có ba cách: một là hiện rõ thân hình, tỏa ánh sáng, chuyển rung mặt đất (6); hai là để lại chính pháp (7), cũng như có Phật ở đời; ba là để lại tượng giáo (8), từ tựa như dung nghi khuôn.</LINE>
            <LINE ID="P0211.L007" ORDER="7" NO="7" SRC_LINE="7" BBOX="61,1531,2428,2079" CONFIDENCE="93.64">phép của Phật. Dung nghi khuôn phép từ tựa ấy đang đáp ứng đòi hỏi của nhân tình ngày nay. Nhân tình đã cảm được qua tượng giáo, ai bảo phải chờ đến khi Phật xuất hiện? Cho nên kinh Tịnh danh (9) nói: "Khéo hiểu được Pháp tướng, thì biết nguồn gốc của chúng sinh" (10). Đến như ba kỳ hội Long hoa (11) ở thành Sí Đầu Mạt (12)</LINE>
            <LINE ID="P0211.L008" ORDER="8" NO="8" SRC_LINE="8" BBOX="338,2088,2428,2641" CONFIDENCE="92.98">thì nhân tình đều cảm được qua việc trông thấy, ai bảo rằng Phật ẩn khuất? Cho nên kinh Pháp hoa (13) nói: "Lúc bấy giờ ta và các tăng đồ đều ra núi Linh Thủy (14). Cung vua Nhương Khư (15) còn có thể lần ra, thì nguồn cội Tây phương làm sao không thấy? Nhưng kẻ nghi ngờ ở đời phần nhiều cho lời kinh không phù hợp sự</LINE>
            <LINE ID="P0211.L009" ORDER="9" NO="9" SRC_LINE="9" BBOX="344,2646,2475,3072" CONFIDENCE="94.54">thật nên đâm ra mờ ám ít tin tưởng, lấy cớ không trông thấy Phật mà chểnh mảng việc tu hành.</LINE>
            <LINE ID="P0211.L010" ORDER="10" NO="10" SRC_LINE="10" BBOX="344,3072,2475,3499" CONFIDENCE="94.54">Kìa chuyện Tam Hoàng Ngũ Đế (16), Tam đại Ngũ Bá (17) Cơ Đán Khổng Khâu (18) biên tập Kinh Thi, chế tác Kinh Lễ, đều nghe nói qua sử sách, nào ai trông thấy đâu! Chuyện họ Thích (19) gióng trống pháp (20) ở</LINE>
            <RUNS>

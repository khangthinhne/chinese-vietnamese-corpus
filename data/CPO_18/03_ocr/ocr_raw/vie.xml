        <PAGE NUMBER="207" IMAGE="E:\Projects\han-viet-corpus\data\CPO_18\02_extraction\pages\page_207.png" IMAGE_SHA256="f494be772212d386652db632fd2fe7095a93d2791d1aee46fba1dd374ad5d571" RAW="03_ocr/raw/qwen/0207.json" SELECTED_ENGINE="qwen" SELECTED_KEY="8f2dfb0f0830d4a1904665f08f524f8f74ebbef4d8bb047811a175fdd027397c" CONFIDENCE="94.94" EMPTY="false" N_LINES="11" N_SRC_LINES="11" N_DROPPED="0" CJK_REMOVED="20">
            <LINE ID="P0207.L001" ORDER="1" NO="1" SRC_LINE="1" BBOX="0,7,2480,269" CONFIDENCE="95.35">Phần II: Nguyên văn tác phẩm dịch và chú thích</LINE>
            <LINE ID="P0207.L002" ORDER="2" NO="2" SRC_LINE="2" BBOX="0,269,2480,530" CONFIDENCE="95.35">(3) Bản Mạc Tư Khoa chép đầu đề bức thư này là: "Dữ Đạo Cao Pháp Minh nhị Pháp sư thư nạn Phật bất kiến hình"</LINE>
            <LINE ID="P0207.L003" ORDER="3" NO="3" SRC_LINE="3" BBOX="0,532,2480,1062" CONFIDENCE="81.67">= Thư gửi hai vị Pháp sư là Đạo Cao và Pháp Minh để vă</LINE>
            <LINE ID="P0207.L004" ORDER="4" NO="4" SRC_LINE="4" BBOX="264,1075,2205,1575" CONFIDENCE="97.95">(6) Giáo pháp (pháp môn): khoa dạy về cách tu luyện để thành Phật. Theo quan niệm nhà Phật, thì những giáo lý mà Phật giảng giải được coi như phép tắc, nên gọi là "pháp". Pháp ấy dẫn dắt chúng sinh vào Đạo và đắc đạo, nên gọi là "môn". Có rất nhiều "pháp môn", tức nhiều kiểu tu luyện để thành Phật, như niệm Phật, thiền định,</LINE>
            <LINE ID="P0207.L005" ORDER="5" NO="5" SRC_LINE="5" BBOX="0,1577,2480,1833" CONFIDENCE="93.63">cúng dàng, bố thí, trì giới v.v. Do đó, người ta hay nói tới "tám vạn bốn nghìn pháp môn", "biển pháp môn", "vô số pháp môn", v.v.</LINE>
            <LINE ID="P0207.L006" ORDER="6" NO="6" SRC_LINE="6" BBOX="0,1833,2480,2089" CONFIDENCE="93.63">(7) Nguyên văn chép là chân (thực), có lẽ nhầm. Cứ theo ngữ cảnh, thì chỗ này phải là chữ trực (nghĩa như hoặc, dịch là chỉ) mới đúng. Đây dịch chưa lại. Bản</LINE>
            <LINE ID="P0207.L007" ORDER="7" NO="7" SRC_LINE="7" BBOX="268,2098,2195,2272" CONFIDENCE="96.4">Đại Chính cũng chép là trực.</LINE>
            <LINE ID="P0207.L008" ORDER="8" NO="8" SRC_LINE="8" BBOX="268,2272,2195,2446" CONFIDENCE="96.4">(8) Nguyên văn câu này là "Chân (trực) không thuyết nhi vô thực da". "Vô thực da" (= không có thực), bản Mạc Tư Khoa chép là "Vô thuật tà ".</LINE>
            <LINE ID="P0207.L009" ORDER="9" NO="9" SRC_LINE="9" BBOX="268,2446,2195,2620" CONFIDENCE="96.4">(9) Phương tây (Tây phương): còn gọi là Tây Thiên hay Tây Trúc, chỉ Ấn Độ, nơi phát tích của đạo Phật. Chữ "Tây</LINE>
            <LINE ID="P0207.L010" ORDER="10" NO="10" SRC_LINE="10" BBOX="8,2618,2480,3060" CONFIDENCE="93.86">phương" ở đây còn có nghĩa là Thế giới cực lạc của Phật A Di Đà (Amitabha); vì cõi ấy, theo Phật giáo, ở về phía tây cõi Tà Bà (Saha) của chúng ta, nên gọi là "Tây phương".</LINE>
            <LINE ID="P0207.L011" ORDER="11" NO="11" SRC_LINE="11" BBOX="8,3060,2480,3501" CONFIDENCE="93.86">(10) Hòa thượng (Upadhyaya): có nghĩa là "thầy tu" đáng lẽ phiên thành "Ô xã", thì lại phiên chệch dần thành "Hòa thượng", lâu ngày hóa quen, để chỉ thầy tu. Chữ</LINE>
            <RUNS>

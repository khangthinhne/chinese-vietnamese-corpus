            <LINE ID="P0205.L001" ORDER="1" NO="1" SRC_LINE="1" BBOX="3,0,2480,272" CONFIDENCE="98.92">Phần II: Nguyên văn tác phẩm dịch và chú thích</LINE>
            <LINE ID="P0205.L002" ORDER="2" NO="2" SRC_LINE="2" BBOX="3,272,2480,545" CONFIDENCE="98.92">Sau đây là toàn văn Sáu bức thư, có kèm theo phần phiên âm, dịch nghĩa và chú thích của chúng tôi.</LINE>
            <LINE ID="P0205.L003" ORDER="3" NO="3" SRC_LINE="10" BBOX="9,2041,2193,2199" CONFIDENCE="87.93">PHIÊN ÂM:</LINE>
            <LINE ID="P0205.L004" ORDER="4" NO="4" SRC_LINE="11" BBOX="275,2244,2480,2357" CONFIDENCE="89.17">DỮ CAO, MINH NHỊ PHÁP SƯ</LINE>
            <LINE ID="P0205.L005" ORDER="5" NO="5" SRC_LINE="12" BBOX="275,2357,2480,2470" CONFIDENCE="89.17">NẠN PHẬT BẤT KIẾN HÌNH THƯ</LINE>
            <LINE ID="P0205.L006" ORDER="6" NO="6" SRC_LINE="13" BBOX="275,2470,2480,2584" CONFIDENCE="89.17">LÝ MIỄU</LINE>
            <LINE ID="P0205.L007" ORDER="7" NO="7" SRC_LINE="14" BBOX="275,2584,2480,2697" CONFIDENCE="89.17">• Miễu vi Giao Châu Thứ sử</LINE>
            <LINE ID="P0205.L008" ORDER="8" NO="8" SRC_LINE="15" BBOX="275,2697,2480,2810" CONFIDENCE="89.17">Phù Đạo xứ thanh hư, tứ đại lý thường, nhi hữu pháp môn, diệu xuất quần vực. Nhược xưng kỳ xảo năng</LINE>
            <LINE ID="P0205.L009" ORDER="9" NO="9" SRC_LINE="16" BBOX="272,2816,2480,3158" CONFIDENCE="89.52">lợi vật, độ thoát vô lượng vi giáo, hà dĩ bất kiến chân hình ư thế? Chân không thuyết nhi vô thực da?</LINE>
            <LINE ID="P0205.L010" ORDER="10" NO="10" SRC_LINE="17" BBOX="272,3158,2480,3499" CONFIDENCE="89.52">Kim chính tụt tầm tây phương căn nguyên, phục nguyện Đại hòa thượng thủy hoài, doãn nạp hạ tâm, vô tích thần cáo.</LINE>

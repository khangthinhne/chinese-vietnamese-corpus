            1024,
            1959,
            1079
          ],
          "confidence": 47.56
        },
        {
          "text": "陛下惠燭海隅明言",
          "bbox": [
            219,
            1079,
            1959,
            1135
          ],
          "confidence": 47.56
        },
        {
          "text": "言屬天安爲寺稱天休",
          "bbox": [
            219,
            1135,
            1959,
            1190
          ],
          "confidence": 47.56
        },
        {
          "text": "法師",
          "bbox": [
            219,
            1190,
            1959,
            1245
          ],
          "confidence": 47.56
        },
        {
          "text": "難佛不見形君垣",
          "bbox": [
            219,
            1245,
            1959,
            1300
          ],
          "confidence": 47.56
        },
        {
          "text": "垣問至聖頭睡之君",
          "bbox": [
            219,
            1300,
            1959,
            1356
          ],
          "confidence": 47.56
        },
        {
          "text": "君垣牆票遂得門有",
          "bbox": [
            219,
            1356,
            1959,
            1411
          ],
          "confidence": 47.56
        },
        {
          "text": "髣髴儀軌應今八知",
          "bbox": [
            219,
            1411,
            1959,
            1466
          ],
          "confidence": 47.56
        },
        {
          "text": "知星生相至荒超經",
          "bbox": [
            219,
            1466,
            1959,
            1521
          ],
          "confidence": 47.56
        },
        {
          "text": "云時我及眾僧俱",
          "bbox": [
            219,
            1521,
            1959,
            1577
          ],
          "confidence": 47.56
        },
        {
          "text": "爲不覩而世之疑",
          "bbox": [
            219,
            1577,
            1959,
            1632
          ],
          "confidence": 47.56
        },
        {
          "text": "華曰只故已惠明",
          "bbox": [
            219,
            1624,
            1967,
            1628
          ],
          "confidence": 30.0
        },

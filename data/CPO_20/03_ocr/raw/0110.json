      "lines": [
        {
          "text": "丙辰秋葆真観記",
          "bbox": [
            291,
            275,
            1788,
            579
          ],
          "confidence": 42.14
        },
        {
          "text": "吾人於明覆耳於負訓才柇然如賈三追騖疑。",
          "bbox": [
            291,
            579,
            1788,
            883
          ],
          "confidence": 42.14
        },
        {
          "text": "崖路白世穿奉止寢軒",
          "bbox": [
            284,
            875,
            1788,
            930
          ],
          "confidence": 10.0
        },
        {
          "text": "浪忤偶之味串有更堂並",
          "bbox": [
            284,
            930,
            1788,
            986
          ],
          "confidence": 10.0
        },
        {
          "text": "學足幸凶又以理開地愛西",
          "bbox": [
            284,
            986,
            1788,
            1041
          ],
          "confidence": 10.0
        },
        {
          "text": "願三之五矣。因公階山",
          "bbox": [
            284,
            1041,
            1788,
            1096
          ],
          "confidence": 10.0
        },
        {
          "text": "途蘇陟心非務無依板",
          "bbox": [
            284,
            1096,
            1788,
            1151
          ],
          "confidence": 10.0
        },
        {
          "text": "華大既變已年曹之南",
          "bbox": [
            284,
            1151,
            1788,
            1207
          ],
          "confidence": 10.0
        },
        {
          "text": "諸支無四獲城為後水次",
          "bbox": [
            284,
            1207,
            1788,
            1262
          ],
          "confidence": 10.0
        },
        {
          "text": "攀角造此情求知命在沼",
          "bbox": [
            284,
            1262,
            1788,
            1317
          ],
          "confidence": 10.0
        },
        {
          "text": "履有艱事而六刑參亭旁",
          "bbox": [
            284,
            1317,
            1788,
            1372
          ],
          "confidence": 10.0
        },
        {
          "text": "早蓋家戾十解朝方四",
          "bbox": [
            284,
            1372,
            1788,
            1428
          ],
          "confidence": 10.0
        },
        {
          "text": "騫駟而六刑參亭旁",
          "bbox": [
            284,
            1428,
            1788,
            1483
          ],
          "confidence": 10.0
        },
        {
          "text": "八月，余垂钓。",
          "bbox": [
            277,
            1475,
            1788,
            1478
          ],
          "confidence": 30.0
        },
        {
          "text": "山以雅流兴材。",
          "bbox": [
            277,
            1478,
            1788,
            1482
          ],
          "confidence": 30.0
        },
        {
          "text": "其阴蕉而庭交茶壇。",
          "bbox": [
            277,
            1482,
            1788,
            1485
          ],
          "confidence": 30.0
        },
        {
          "text": "倚墨而延默。",
          "bbox": [

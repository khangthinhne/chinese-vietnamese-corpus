            1743,
            1967
          ],
          "confidence": 58.41
        },
        {
          "text": "寒祝沉明能我于寂色",
          "bbox": [
            152,
            1967,
            1743,
            2040
          ],
          "confidence": 58.41
        },
        {
          "text": "半仰步明瞩其技为在",
          "bbox": [
            152,
            2040,
            1743,
            2112
          ],
          "confidence": 58.41
        },
        {
          "text": "将岸登归最豪得末以",
          "bbox": [
            152,
            2112,
            1743,
            2184
          ],
          "confidence": 58.41
        },
        {
          "text": "夜舟而月非能褐因溪",
          "bbox": [
            152,
            2184,
            1743,
            2256
          ],
          "confidence": 58.41
        },
        {
          "text": "石桥辞月候不鬓居在",
          "bbox": [
            152,
            2256,
            1743,
            2328
          ],
          "confidence": 58.41
        },
        {
          "text": "桥上至回相中与非涯但",
          "bbox": [
            152,
            2328,
            1743,
            2401
          ],
          "confidence": 58.41
        },
        {
          "text": "流遣很秋尽可人暗六",

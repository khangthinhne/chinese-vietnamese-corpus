      "lines": [
        {
          "text": "壬申夏福川樺鍾碑記",
          "bbox": [
            485,
            550,
            1214,
            627
          ],
          "confidence": 92.41
        },
        {
          "text": "吾邑古名吁麻郷，陳朝弟七帝裕宗母家",
          "bbox": [
            341,
            694,
            1661,
            759
          ],
          "confidence": 88.43
        },
        {
          "text": "也，黎后侍明宗而生帝，長秋榮養，戢畹流芳。",
          "bbox": [
            256,
            758,
            1684,
            825
          ],
          "confidence": 81.85
        },
        {
          "text": "後父陳壽眉位上柱國掌尚書省，二弟聯登",
          "bbox": [
            252,
            822,
            1658,
            889
          ],
          "confidence": 92.08
        },
        {
          "text": "麗仕。門楣之慶。赫耀分閭。紹豐八年。營",
          "bbox": [
            249,
            886,
            1658,
            953
          ],
          "confidence": 88.93
        },
        {
          "text": "建本鄉崇真寺.鑄造洪鍾高可三尺.銅約二",
          "bbox": [
            249,
            951,
            1655,
            1017
          ],
          "confidence": 92.25
        },
        {
          "text": "千筋，法音鏗鈎然。里話云。中古遭亂。其鍾為",
          "bbox": [
            249,
            1017,
            1655,
            1084
          ],
          "confidence": 81.79
        },
        {
          "text": "頑悍輩搬挈而東，銅離寺遂失音，挈取者載",
          "bbox": [
            248,
            1081,
            1653,
            1150
          ],
          "confidence": 96.22
        },
        {
          "text": "回海陽邑。投之池畔。以架橋。尋有本鄉學生。",
          "bbox": [
            249,
            1147,
            1675,
            1215
          ],
          "confidence": 93.83
        },
        {
          "text": "偶遊其地，見鍾而扣之，金磬復振，土人聞之。",
          "bbox": [
            246,
            1211,
            1673,
            1278
          ],
          "confidence": 87.91
        },
        {
          "text": "咸詫異，再交還本寺，事屬茫遂無徵，而風樓",
          "bbox": [
            245,
            1275,
            1648,
            1339
          ],
          "confidence": 90.6
        },
        {
          "text": "蒲響.稔著盝蹟.傳為禪林寶器.迨黎季兵變.",
          "bbox": [
            87,
            1336,
            1672,
            1403
          ],
          "confidence": 83.11
        },
        {
          "text": "盡括寓内銅器供用。此鍾併歸烏有其鍾銘",
          "bbox": [
            243,
            1400,
            1647,
            1469
          ],
          "confidence": 92.01
        },
        {
          "text": "抄錄。俱銷歇無存。寥寥三十年中。世局滄桑。",
          "bbox": [
            242,
            1461,
            1670,
            1533
          ],
          "confidence": 92.58
        },
        {
          "text": "佛教亦渐堙晦，百八遣音，寂然朝暮，臨古刹",
          "bbox": [
            242,
            1529,
            1645,
            1597
          ],
          "confidence": 90.03
        },
        {
          "text": "而訪遺文者，徒然撫累興懷，今歲鄉政稍暇，",
          "bbox": [
            240,
            1593,
            1669,
            1662
          ],
          "confidence": 91.21
        },
        {
          "text": "員色與善信等，將蒙謀募工起鑄，適安樂縣",
          "bbox": [
            242,
            1659,
            1644,
            1728
          ],
          "confidence": 97.68
        },
        {
          "text": "之兩館洲，事力涸幣轉鬻伊寺舊鍾，爰即辨",
          "bbox": [
            87,
            1725,
            1656,
            1792
          ],
          "confidence": 89.07
        },
        {
          "text": "貨購來，懸之禪院，以備通玄覺俗焉，當聞之。",
          "bbox": [
            237,
            1784,
            1666,
            1856
          ],
          "confidence": 89.07
        },
        {
          "text": "道形於器，而器之生消廢舉，則關乎數與時",
          "bbox": [
            237,
            1848,
            1641,
            1914
          ],
          "confidence": 92.75
        },
        {
          "text": "吾篲鍾鑄於陳紹豐戊子銷於黎昭統丁未",
          "bbox": [
            237,
            1906,
            1641,
            1980
          ],
          "confidence": 91.75
        },
        {
          "text": "更歷朝代。閱四百四十年宇宙間豈有永存",
          "bbox": [
            235,
            1972,
            1639,
            2043
          ],
          "confidence": 92.83
        },
        {
          "text": "不減之器，有形必壞，適其理然也。新買鍾，是",
          "bbox": [
            235,
            2039,
            1638,
            2111
          ],
          "confidence": 87.48
        },
        {
          "text": "黎正和辛巳所鑄。百十年前之物。挨諸理數。",
          "bbox": [
            234,
            2103,
            1663,
            2179
          ],
          "confidence": 94.0
        }
      ],

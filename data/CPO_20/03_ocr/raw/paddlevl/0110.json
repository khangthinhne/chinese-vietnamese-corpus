      "lines": [
        {
          "text": "丙辰秋葆真觀記",
          "bbox": [
            496,
            278,
            1478,
            355
          ],
          "confidence": 97.16
        },
        {
          "text": "吾人於覆載間，稍得精粹之稟具此知覺",
          "bbox": [
            382,
            426,
            1700,
            489
          ],
          "confidence": 94.6
        },
        {
          "text": "神情，瞭明耳目，可爱惜存養之，若使心為形",
          "bbox": [
            296,
            490,
            1697,
            553
          ],
          "confidence": 88.17
        },
        {
          "text": "役，而屈折於勢利，昏潰於物欲，甚至斷天",
          "bbox": [
            295,
            553,
            1695,
            617
          ],
          "confidence": 89.39
        },
        {
          "text": "真，事非辜负造化之厚吾生耶，古人心身之",
          "bbox": [
            293,
            615,
            1695,
            681
          ],
          "confidence": 88.75
        },
        {
          "text": "學。炳有明訓。士之馳騖於世。鮮能砥礪厥躬。",
          "bbox": [
            291,
            679,
            1717,
            745
          ],
          "confidence": 95.62
        },
        {
          "text": "訑訑然以才辯爭高求諸方寸中所存者幾",
          "bbox": [
            293,
            745,
            1692,
            809
          ],
          "confidence": 90.48
        },
        {
          "text": "希殆如賈柑者云，金玉而敗絮也。余少時孟",
          "bbox": [
            291,
            806,
            1692,
            873
          ],
          "confidence": 86.54
        },
        {
          "text": "浪，學駁而心放。早履華途。分願慰足。而乖崖",
          "bbox": [
            290,
            870,
            1691,
            937
          ],
          "confidence": 90.76
        },
        {
          "text": "忤物。棱角招謊。蓋有大蘇之三不幸焉。中路",
          "bbox": [
            290,
            937,
            1689,
            1000
          ],
          "confidence": 80.76
        },
        {
          "text": "偶逢屯造，周歷家艱，既陟黠之降凶，又炊白",
          "bbox": [
            288,
            999,
            1688,
            1064
          ],
          "confidence": 82.15
        },
        {
          "text": "之遭戚。此間支吾事變，憔悴五内，唯以應世",
          "bbox": [
            287,
            1064,
            1688,
            1129
          ],
          "confidence": 91.45
        },
        {
          "text": "味徇物情，求無戾而已。心身之與道理，未穿",
          "bbox": [
            285,
            1128,
            1686,
            1192
          ],
          "confidence": 92.96
        },
        {
          "text": "串得來。吾知四十六年之非矣。今年開春。奉",
          "bbox": [
            287,
            1190,
            1684,
            1254
          ],
          "confidence": 91.95
        },
        {
          "text": "有皇華之命。獲解刑曹機務。尋因内地報止。",
          "bbox": [
            285,
            1255,
            1708,
            1320
          ],
          "confidence": 90.91
        },
        {
          "text": "更撤使麾在城朝参之暇，無甚公允，爰於寢",
          "bbox": [
            285,
            1312,
            1683,
            1382
          ],
          "confidence": 86.95
        },
        {
          "text": "堂之後。架沼為方亭。南軒依土階東西北軒。",
          "bbox": [
            284,
            1379,
            1706,
            1444
          ],
          "confidence": 96.62
        },
        {
          "text": "並臨水次。亭之四旁。鋪設板座山禺壁八角。",
          "bbox": [
            284,
            1444,
            1705,
            1510
          ],
          "confidence": 93.03
        },
        {
          "text": "各施圖畫標詠其上，處其四面，以受風月，亭",
          "bbox": [
            282,
            1507,
            1680,
            1572
          ],
          "confidence": 85.14
        },
        {
          "text": "前裁鳳仙巨樹。花葉成陰。滿庭雜以芳卉。紹",
          "bbox": [
            281,
            1569,
            1678,
            1636
          ],
          "confidence": 91.97
        },
        {
          "text": "浮素逢。香風襲人。柳塘荒岸。交迭蒼翠。余晨",
          "bbox": [
            281,
            1632,
            1678,
            1700
          ],
          "confidence": 82.79
        },
        {
          "text": "夕盤桓諶寝斯亭，倚槛而品茶，俯流而垂釣。",
          "bbox": [
            282,
            1697,
            1702,
            1765
          ],
          "confidence": 83.35
        },
        {
          "text": "演琴兒於飲局延墨客於吟壇隨興欣適覺",
          "bbox": [
            279,
            1757,
            1677,
            1827
          ],
          "confidence": 85.23
        },
        {
          "text": "有得意，守静養默，而自處於材不材，正性存",
          "bbox": [
            277,
            1819,
            1675,
            1891
          ],
          "confidence": 87.17
        },
        {
          "text": "神而了悟於想非想.保其固有.勉其未能.使",
          "bbox": [
            277,
            1899,
            1673,
            1961
          ],
          "confidence": 92.15
        },
        {
          "text": "斯心不越於矩绳，而無憶乎衿影，是吾盧為",
          "bbox": [
            277,
            1961,
            1673,
            2024
          ],
          "confidence": 85.82
        },
        {
          "text": "養真底安宅也。中夏事成，命曰葆真觀。揚庸",
          "bbox": [

            1190,
            1544,
            1252
          ],
          "confidence": 90.52
        },
        {
          "text": "琴樽適興，不其甚佳。",
          "bbox": [
            193,
            1256,
            919,
            1319
          ],
          "confidence": 93.94
        },
        {
          "text": "先生之意，若不豫何哉？",
          "bbox": [
            195,
            1320,
            985,
            1384
          ],
          "confidence": 97.0
        },
        {
          "text": "曰：風月扁舟，於予成癖。",
          "bbox": [
            195,
            1386,
            978,
            1449
          ],
          "confidence": 92.27
        },
        {
          "text": "惟樂生於心，而後見於跡。",
          "bbox": [
            195,
            1448,
            1424,
            1513
          ],
          "confidence": 92.81
        },
        {
          "text": "又必以其時可也，苟非時則物我扞隔。",
          "bbox": [
            196,
            1505,
            1452,
            1583
          ],
          "confidence": 95.25
        },
        {
          "text": "豈吾與爾之所能獨適哉！",
          "bbox": [
            198,
            1582,
            1038,
            1649
          ],
          "confidence": 95.76
        },
        {
          "text": "我今為士，在四民中。",

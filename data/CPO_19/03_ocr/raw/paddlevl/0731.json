      "lines": [
        {
          "text": "NGÔ THI NHÂM TOÀN TẬP - TẬP III",
          "bbox": [
            196,
            70,
            1993,
            117
          ],
          "confidence": 92.07
        },
        {
          "text": "洪慈體恤之至，真是天高地厚難得以名言。",
          "bbox": [
            349,
            168,
            1662,
            232
          ],
          "confidence": 96.29
        },
        {
          "text": "臣：仰荷洪私，無階報稱。",
          "bbox": [
            353,
            295,
            1548,
            357
          ],
          "confidence": 98.07
        },
        {
          "text": "惟有翹瞻天闕，長傾葵藿之忱；恪守藩封，永述共",
          "bbox": [
            346,
            419,
            1902,
            486
          ],
          "confidence": 99.71
        },
        {
          "text": "球之職。",
          "bbox": [
            198,
            553,
            1364,
            607
          ],
          "confidence": 97.26
        },
        {
          "text": "謹奉表稱謝者。",
          "bbox": [
            349,
            675,
            1304,
            736
          ],
          "confidence": 99.17
        },
        {
          "text": "伏以皇極建中，廣運大同之化；聖恩覃遠，難名",
          "bbox": [
            346,
            798,
            1897,
            866
          ],
          "confidence": 99.82
        },
        {
          "text": "洪造之仁。",
          "bbox": [
            202,
            938,
            531,
            989
          ],
          "confidence": 98.43
        },
        {
          "text": "翘首云端，捫心海際。",
          "bbox": [
            278,
            1055,
            1024,
            1117
          ],
          "confidence": 90.57
        },
        {
          "text": "欽惟皇帝陛下：奉三體道，錫五綏猷。",
          "bbox": [
            347,
            1179,
            1474,
            1243
          ],
          "confidence": 97.27
        },
        {
          "text": "主宰於上不勞，惟深惟幾；精神之所運動，包涵其大。",
          "bbox": [
            350,
            1303,
            1849,
            1369
          ],
          "confidence": 99.9
        },
        {
          "text": "無外所照所至，氣血莫不尊親。",
          "bbox": [
            347,
            1432,
            1313,
            1496
          ],
          "confidence": 99.65
        },
        {
          "text": "際蟠盡在於帡幪，胞與都歸於容蓋。",
          "bbox": [
            348,
            1558,
            1456,
            1624
          ],
          "confidence": 99.58
        },
        {
          "text": "昊天之府者時也，體天行事，回泉於遐阻而不遺；",
          "bbox": [
            354,
            1685,
            1881,
            1751
          ],
          "confidence": 99.86
        },
        {
          "text": "聖人之貨如泉然，與人爲公，施濟在痌瘝而更切。",
          "bbox": [
            143,
            1812,
            1725,
            1877
          ],
          "confidence": 98.36
        },
        {
          "text": "蓋發育道存於廣大，而阜成義本於通融。",
          "bbox": [
            336,
            1936,
            1727,
            2004
          ],
          "confidence": 99.82
        },
        {
          "text": "法春秋歲首體元，夏朔寵頒，七政示璣衡之象；取",
          "bbox": [
            350,
            2063,
            1903,
            2129
          ],
          "confidence": 99.88
        },
        {
          "text": "噬嗑日中爲市，周關弛禁，九泉通寶貨之途。",
          "bbox": [
            202,
            2189,
            1586,
            2255
          ],
          "confidence": 98.81
        },
        {
          "text": "明時欽天度之昭彰，利用仰皇仁之溥博。",
          "bbox": [
            356,
            2315,
            1603,
            2379
          ],
          "confidence": 99.48
        },
        {
          "text": "天乃道道乃久，天王正朔億年承壽考之休；土有人",
          "bbox": [
            205,
            2434,
            1903,
            2499
          ],
          "confidence": 99.94
        },
        {
          "text": "人有財，土宇版章萬世溢富豐之頒。",

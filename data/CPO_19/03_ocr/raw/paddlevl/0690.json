      "lines": [
        {
          "text": "BANG GIAO HAO THOAI",
          "bbox": [
            1294,
            61,
            1812,
            101
          ],
          "confidence": 99.55
        },
        {
          "text": "茲年三月日，據臣國昇龍城鎮目稟稱，訪得黎嗣",
          "bbox": [
            265,
            153,
            1811,
            219
          ],
          "confidence": 97.64
        },
        {
          "text": "君之次妹，黎氏玉蕊來詣具言，見已適人，不願",
          "bbox": [
            113,
            296,
            1811,
            361
          ],
          "confidence": 99.1
        },
        {
          "text": "內投，見將手札，憑寄黎嗣君知會，其餘並無消息。",
          "bbox": [
            122,
            438,
            1701,
            503
          ],
          "confidence": 98.75
        },
        {
          "text": "臣切照，伊等流落竄越，已閱再期，蹤跡杳然，寔",
          "bbox": [
            270,
            584,
            1809,
            648
          ],
          "confidence": 99.86
        },
        {
          "text": "難究知下落，惟此係遵旨辨理之件，不敢視爲應故，仍",
          "bbox": [
            115,
            727,
            1813,
            793
          ],
          "confidence": 98.93
        },
        {
          "text": "再行確切找尋，想必得黎人送投，庶以答揚天子慈懷。",
          "bbox": [
            115,
            868,
            1731,
            934
          ],
          "confidence": 99.83
        },
        {
          "text": "今奉到廷寄諭旨，近日維祁聽唆瀆陳一案，上廑",
          "bbox": [
            263,
            1014,
            1808,
            1081
          ],
          "confidence": 98.99
        },
        {
          "text": "聖懷，著將辨理，這案之來瀝原委，俾臣看知。其伊眷",
          "bbox": [
            119,
            1157,
            1812,
            1224
          ],
          "confidence": 99.86
        },
        {
          "text": "屬之難尋者，諭令毋庸查送，臣始奉停止不辨。",
          "bbox": [
            121,
            1300,
            1578,
            1366
          ],
          "confidence": 99.46
        },
        {
          "text": "欽惟大皇帝陛下，經緯三才，統宗萬國，春溫秋肅，莫",
          "bbox": [
            61,
            1446,
            1816,
            1511
          ],
          "confidence": 99.98
        },
        {
          "text": "非天道至公，以黎嗣君奔亡之餘，俯賜矜容而猶喧愬",
          "bbox": [
            121,
            1587,
            1810,
            1653
          ],
          "confidence": 99.11
        },
        {
          "text": "干嚴，即復裁之以法，此尤見聖人代天行事，雨露雷",
          "bbox": [
            120,
            1731,
            1811,
            1796
          ],
          "confidence": 99.84
        },
        {
          "text": "霆，一順自然，不能云云以譽大也。",
          "bbox": [
            123,
            1875,
            1213,
            1938
          ],
          "confidence": 99.8
        },
        {
          "text": "又臣國人口，前經進關內投，奉旨送回阮廷沛等，該",
          "bbox": [
            271,
            2022,
            1818,
            2085
          ],
          "confidence": 99.88
        },
        {
          "text": "二百二十人，臣爲之綏集，復其盧井，予以產業，俾相",
          "bbox": [
            119,
            2155,
            1812,
            2220
          ],
          "confidence": 99.55
        },
        {
          "text": "安於覆載之間，以上副聖天子泛愛群生之德。",
          "bbox": [
            120,
            2291,
            1523,
            2355
          ],
          "confidence": 99.86
        },
        {
          "text": "上年端陽節，臣入覲在途，欽蒙恩賜賞節，馳",
          "bbox": [
            268,
            2423,
            1817,
            2487
          ],
          "confidence": 99.88
        },
        {
          "text": "驛放給。茲值南薰協爽，赤陸舒輝，慶長養之嘉",
          "bbox": [
            119,
            2548,
            1815,
            2613
          ],
          "confidence": 98.63
        },
        {
          "text": "時，仰柔懷之渥澤。臣遙瞻九陛，阻奉趨蹌，重蒙聖慈",
          "bbox": [
            122,
            2674,
            1812,
            2741
          ],
          "confidence": 99.95
        }
      ],

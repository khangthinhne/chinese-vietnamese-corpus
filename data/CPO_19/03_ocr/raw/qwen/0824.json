            1904,
            2245
          ],
          "confidence": 83.95
        },
        {
          "text": "燕及皇天，配命烈祖。",
          "bbox": [
            200,
            2271,
            1913,
            2486
          ],
          "confidence": 95.78
        },
        {
          "text": "備膺百福，兼收十全。",

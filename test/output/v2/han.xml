                <STC ID="CPO_19.001.P001.S001">| 卜與高明一法師離佛不見形書</STC>
                <STC ID="CPO_19.001.P001.S002">封</STC>
                <STC ID="CPO_19.001.P001.S003">﹣ 咩城君巢細</STC>
